config_version=5

[application]

config/name="AARPG"
run/main_scene="uid://bwflt7uax5m6i"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://bmdqymf1ds3us"

[autoload]

AudioManager="*uid://dv2kgkcbtpxyr"
LevelManager="*uid://3rnpe4jx7br2"
