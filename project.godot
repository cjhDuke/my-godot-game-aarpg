PlayerManager="*uid://cwvtlya7vog2f"
SceneTransition="*uid://bu1cxxl11qpup"
SaveManager="*uid://o625n35emdh0"
PauseMenu="*uid://fft2clkfyt2x"
DialogueSystem="*uid://dr1y8nonhctu1"

